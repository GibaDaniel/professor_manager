              },
              "contextPath": "/Professor/_CrsOffr",
              "controlConfiguration": {
                "_Schedule/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "widthIncludingColumnHeader": true
                  }
                },
                "_Enrollment/@com.sap.vocabularies.UI.v1.LineItem#ForCoursePage": {
                  "tableSettings": {
